<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="15" alignment="TOP_CENTER" prefWidth="600" prefHeight="650"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.epet36.biblioteca.controller.NuevoPrestamoController"
      style="-fx-padding: 20px;">

    <Label text="Registrar Nuevo Préstamo" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="lblMensaje" prefWidth="560" wrapText="true" text="" />

    <!-- Sección Profesor -->
    <TitledPane text="Datos del Responsable y Materia" collapsible="false">
        <VBox spacing="10" style="-fx-padding: 10px;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Profesor Responsable (*):"/>
                    <HBox spacing="5">
                        <!-- Campo no editable, se llena con el buscador -->
                        <TextField fx:id="txtProfesorSeleccionado" promptText="Haga clic en 🔍 para seleccionar..." editable="false" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa;"/>

                        <!-- BOTÓN BUSCAR PROFESOR -->
                        <Button text="🔍 Buscar" onAction="#onBuscarProfesorClick"
                                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-cursor: hand;" />

                        <!-- BOTÓN NUEVO PROFESOR -->
                        <Button text="+ Nuevo" onAction="#onAgregarProfesorClick"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
                <VBox spacing="5" prefWidth="200">
                    <Label text="Materia / Destino:"/>
                    <TextField fx:id="txtMateria" promptText="Ej: Historia 3° B" />
                </VBox>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- Sección Libro -->
    <TitledPane text="Datos del Libro (Se creará si no existe)" collapsible="false">
        <VBox spacing="10" style="-fx-padding: 10px;">
            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Código / ISBN:"/>
                    <TextField fx:id="txtCodigoLibro" promptText="Opcional pero recomendado" />
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Título (*):"/>
                    <TextField fx:id="txtTituloLibro" promptText="Ej: Álgebra de Baldor" />
                </VBox>
            </HBox>
            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Autor:"/>
                    <TextField fx:id="txtAutorLibro" />
                </VBox>
                <VBox spacing="5" prefWidth="120">
                    <Label text="Cantidad:"/>
                    <Spinner fx:id="spnCantidad" prefWidth="120"/>
                </VBox>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- Sección Préstamo -->
    <TitledPane text="Detalles del Préstamo" collapsible="false">
        <VBox spacing="10" style="-fx-padding: 10px;">
            <Label text="Fecha prevista de devolución:"/>
            <DatePicker fx:id="dpFechaVencimiento" prefWidth="200" />
        </VBox>
    </TitledPane>

    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
        <Button text="Registrar Préstamo" onAction="#onRegistrarPrestamoClick"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
    </HBox>
</VBox>
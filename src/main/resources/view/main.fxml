<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.epet36.biblioteca.controller.MainController">

    <!-- MENÚ LATERAL (SIDEBAR) -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20px;" prefWidth="220">
            <Label text="Biblioteca" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets bottom="30.0" />
                </VBox.margin>
            </Label>

            <!-- Botones de navegación -->
            <Button text="Dashboard" onAction="#mostrarDashboard" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>

            <Button text="Nuevo Préstamo" onAction="#mostrarNuevoPrestamo" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>

            <Button text="Devolución" onAction="#mostrarDevolucion" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>

            <Button text="Profesores" onAction="#mostrarProfesores" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-alignment: BASELINE_LEFT; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS" /> <!-- Espaciador para tirar el botón salir abajo -->

            <Button text="Cerrar Sesión" maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- EL CENTRO ESTÁ VACÍO. SE LLENARÁ DINÁMICAMENTE DESDE EL CONTROLADOR -->
    <center>
        <!-- Aquí cargará dashboard.fxml o nuevo_prestamo.fxml -->
    </center>

</BorderPane>
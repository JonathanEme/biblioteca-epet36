<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- Envolvemos todo en un ScrollPane para evitar que quede nada afuera -->
<ScrollPane fitToWidth="true" fitToHeight="true"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.epet36.biblioteca.controller.InventarioController"
            style="-fx-background-color: #f4f6f9; -fx-padding: 0;">

    <content>
        <HBox spacing="20" maxWidth="Infinity" maxHeight="Infinity" style="-fx-padding: 20px;">

            <!-- LADO IZQUIERDO: Tabla -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Inventario de Libros" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <TextField fx:id="txtBuscar" promptText="Buscar por Título, Autor, Código o ISBN..." style="-fx-padding: 8px;"/>

                <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS" maxWidth="Infinity"
                           style="-fx-selection-bar: #3498db; -fx-selection-bar-non-focused: #bdc3c7; -fx-background-insets: 0;">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Código/ISBN" prefWidth="120"/>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="250"/>
                        <TableColumn fx:id="colAutor" text="Autor" prefWidth="150"/>
                        <TableColumn fx:id="colStock" text="Disponibles / Total" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- LADO DERECHO: Formulario de Edición (Adaptable y Elástico) -->
            <VBox spacing="12" minWidth="300" prefWidth="350" maxWidth="380" HBox.hgrow="SOMETIMES"
                  style="-fx-background-color: #f8f9fa; -fx-padding: 20px; -fx-border-color: #dee2e6; -fx-border-radius: 5px;">

                <Label text="Detalle del Libro" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <Label fx:id="lblMensaje" wrapText="true" maxWidth="Infinity" style="-fx-font-weight: bold;"/>

                <!-- Código e ISBN en la misma línea pero expandibles -->
                <HBox spacing="10" maxWidth="Infinity">
                    <VBox spacing="3" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Código Interno:"/>
                        <TextField fx:id="txtCodigo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="3" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="ISBN:"/>
                        <TextField fx:id="txtIsbn" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <VBox spacing="3" maxWidth="Infinity">
                    <Label text="Título (*):"/>
                    <TextField fx:id="txtTitulo" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="3" maxWidth="Infinity">
                    <Label text="Autor:"/>
                    <TextField fx:id="txtAutor" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="3" maxWidth="Infinity">
                    <Label text="Materia / Categoría:"/>
                    <TextField fx:id="txtCategoria" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="3" maxWidth="Infinity">
                    <Label text="Editorial:" />
                    <TextField fx:id="txtEditorial" promptText="Ej. Santillana" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="3" maxWidth="Infinity">
                    <Label text="Año de Publicación:" />
                    <TextField fx:id="txtAnioPublicacion" promptText="Ej. 2022" maxWidth="Infinity"/>
                </VBox>

                <HBox spacing="15" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-padding: 5px 0 0 0; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Stock Total Físico:" style="-fx-font-weight: bold;"/>
                        <Spinner fx:id="spnCantidadTotal" maxWidth="Infinity" editable="true"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblDisponibles" text="-" maxWidth="Infinity" style="-fx-text-fill: #0056b3; -fx-font-style: italic;"/>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Botones inferiores alineados y flexibles -->
                <HBox spacing="10" alignment="CENTER_RIGHT" maxWidth="Infinity">
                    <Button text="Limpiar / Nuevo" onAction="#onLimpiarClick" style="-fx-cursor: hand;"/>
                    <Button text="Guardar" onAction="#onGuardarClick"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

        </HBox>
    </content>
</ScrollPane>